 struct uniwill_device_features_t uniwill_device_features;
+
+/* The Slayer R9T EC exposes the Uniwill WMI interface, but the generic
+ * keyboard-driver probe writes model-independent defaults to EC registers.
+ * Keep this interface read-only at probe/remove/suspend time on this model;
+ * explicit fan/profile changes go through tuxedo_io after its EC feature
+ * detection has completed.
+ */
+static bool uniwill_is_gamegaraj_slayer_r9t(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "GAME GARAJ") &&
+	       dmi_match(DMI_PRODUCT_NAME, "SLAYER R9T");
+}
 
 static bool uw_feats_loaded = false;
 
@@ -2170,6 +2183,9 @@
 	int status;
 	struct uniwill_device_features_t *uw_feats;
 
+	if (uniwill_is_gamegaraj_slayer_r9t())
+		return 0;
+
 	set_rom_id();
 
 	uw_feats = uniwill_get_device_features();
@@ -2236,6 +2252,13 @@
 static void uniwill_keyboard_remove(struct platform_device *dev)
 #endif
 {
+	if (uniwill_is_gamegaraj_slayer_r9t()) {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0)
+		return 0;
+#else
+		return;
+#endif
+	}
 	if (uw_charging_prio_loaded)
 		sysfs_remove_group(&dev->dev.kobj, &uw_charging_prio_attr_group);
 
