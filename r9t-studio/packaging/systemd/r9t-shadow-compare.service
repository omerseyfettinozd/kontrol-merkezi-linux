# Faz 2 acceptance only: logs r9td shadow vs legacy status once a minute.
# Root so it can reach both sockets (legacy socket is the desktop user's, 0600).
[Unit]
Description=R9T Studio shadow comparison logger (Faz 2 acceptance)
After=r9td-shadow.service slayer-r9t.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/r9t-studio/shadow-compare.py --out /var/lib/r9t/shadow-compare.jsonl --interval 60
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/var/lib/r9t
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
