# R9T Studio daemon, control mode: the single hardware writer.
[Unit]
Description=R9T Studio daemon (control)
Documentation=file:///usr/share/doc/r9t-studio/04_ana_plan.md
# Safety invariant 6: never next to the legacy service or the shadow.
Conflicts=slayer-r9t.service r9td-shadow.service
After=systemd-modules-load.service power-profiles-daemon.service dbus.service polkit.service slayer-r9t.service r9td-shadow.service
# If r9td keeps failing, give the hardware back to the legacy service.
OnFailure=r9t-fallback.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/r9t-studio/r9td
# Safety invariant 2: fans to EC auto even after SIGKILL.
ExecStopPost=/usr/lib/r9t-studio/r9td --emergency-auto
WatchdogSec=10
Restart=on-failure
RestartSec=500ms
# systemd ≥ 254: restart without passing through 'failed', so OnFailure= (fallback to
# the legacy service) fires only once the start limit is exhausted. Without it,
# systemd 262 triggers OnFailure= before the auto-restart and Conflicts= cancels it.
RestartMode=direct
TimeoutStopSec=15
SyslogIdentifier=r9td
RuntimeDirectory=r9td
RuntimeDirectoryMode=0755
StateDirectory=r9t
StateDirectoryMode=0750
SupplementaryGroups=r9t
UMask=0027

# NVML Set/ResetGpuLockedClocks returns NO_PERMISSION without CAP_SYS_ADMIN
# (measured with setpriv: no other single capability suffices).
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/tuxedo_io rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
SystemCallArchitectures=native
KeyringMode=private

[Install]
WantedBy=multi-user.target
