# Read-only shadow of r9td (Faz 2). Runs next to the legacy slayer-r9t.service and
# never writes hardware: no Conflicts=, no ExecStopPost, /sys read-only, no capabilities.
[Unit]
Description=R9T Studio daemon (read-only shadow)
Documentation=file:///usr/share/doc/r9t-studio/04_ana_plan.md
After=systemd-modules-load.service power-profiles-daemon.service dbus.service

[Service]
Type=notify
ExecStart=/usr/lib/r9t-studio/r9td --shadow
Restart=on-failure
RestartSec=2
SyslogIdentifier=r9td
RuntimeDirectory=r9td
RuntimeDirectoryMode=0755
StateDirectory=r9t
StateDirectoryMode=0750
SupplementaryGroups=r9t
UMask=0027

# Hardening (target: systemd-analyze security ≤ 4.0)
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/sys
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DevicePolicy=closed
# By device class, not path: a path is resolved once when the unit starts, and at
# boot /dev/nvidia0 appears a few ms after r9td (2026-10-22: 38.0607 vs 38.0679),
# which left NVML locked out (error 999) until a restart. The majors are registered
# by then (After=systemd-modules-load.service). char-nvidia is major 195
# (nvidia0..N, nvidiactl, nvidia-modeset).
DeviceAllow=char-tuxedo_io_cdev r
DeviceAllow=char-nvidia rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# chown(2) for the socket group (root:r9t 0660)
SystemCallFilter=@chown
SystemCallArchitectures=native
KeyringMode=private

[Install]
WantedBy=multi-user.target
