# sysusers.d (r9t group) and daemon-reload run through systemd's own pacman hooks.

post_install() {
    cat <<'MSG'
==> R9T Studio kuruldu; hiçbir servis kendiliğinden başlatılmadı.
    Eski sistemle yan yana gölge:  systemctl enable --now r9td-shadow.service
    Deneme:                        r9tctl switch --trial 20
    Kalıcı geçiş:                  r9tctl switch --commit  &&  r9tctl desktop --commit (kullanıcı olarak)
    Kullanıcı r9t grubunda olmalı:  usermod -aG r9t <kullanıcı>  (yeniden giriş gerekir)
MSG
}

post_upgrade() {
    # Otherwise the old binaries keep running after an upgrade (2026-11-21: three
    # installs in a row ran the previous r9td/session/UI until restarted by hand).
    # r9td's stop puts the fans on EC auto and verifies it; start restores the last
    # requested settings within ~2 s.
    if systemctl is-active --quiet r9td.service; then
        echo "==> r9td yeni sürümle yeniden başlatılıyor (fanlar birkaç saniye EC otomatikte)"
        systemctl try-restart r9td.service || echo "==> r9td yeniden başlatılamadı: systemctl restart r9td.service"
    fi
    if systemctl is-active --quiet r9td-shadow.service; then
        systemctl try-restart r9td-shadow.service
    fi
    # Session agent and tray UI of every logged-in user (only units already running).
    for u in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        systemctl --user -M "$u@" try-restart r9t-session.service r9t-studio-tray.service 2>/dev/null \
            && echo "==> $u: r9t-session ve arayüz yeni sürümle yeniden başlatıldı"
    done
    return 0
}

pre_remove() {
    # Never leave the machine without a controller: r9td's ExecStopPost puts the fans on
    # EC auto, then the legacy service takes over if it is still installed.
    systemctl disable --now r9td.service r9td-shadow.service 2>/dev/null || true
    if systemctl cat slayer-r9t.service >/dev/null 2>&1; then
        systemctl enable --now slayer-r9t.service 2>/dev/null || true
    fi
    rm -f /var/lib/r9t/committed
    echo "==> Masaüstü tarafını kaldırmadan önce kullanıcı olarak: r9tctl desktop --rollback"
}
