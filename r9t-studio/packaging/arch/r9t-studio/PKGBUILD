# R9T Studio (plan Faz 5): r9td, r9t-session, r9tctl, the Tauri UI and their units.
# Built from this repository's working tree (tracked files only):
#   cd r9t-studio/packaging/arch/r9t-studio && makepkg -s
# Installing it replaces the dev install under /usr/local: see packaging/arch/README.md.
pkgname=r9t-studio
pkgver=0.1.0.r63.g1b1d9a3
pkgrel=1
pkgdesc='GameGaraj Slayer R9T control center: hardware daemon, session agent, CLI and UI'
arch=('x86_64')
url='https://github.com/omerseyfettinozd/kontrol-merkezi-linux'
license=('GPL-2.0-only')
depends=('glibc' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'dbus' 'systemd' 'polkit'
         'power-profiles-daemon' 'pipewire' 'wireplumber' 'python')
makedepends=('cargo' 'nodejs' 'npm' 'git')
optdepends=('slayer-r9t-fan-dkms: fan control (r9t_fan kernel module)'
            'tuxedo-drivers-dkms: EC, keyboard RGB and Fn-Lock'
            'nvidia-utils: dGPU telemetry and clock limits (NVML)'
            'waybar: r9tctl waybar module')
backup=()
install=r9t-studio.install
options=('!lto' '!debug')

_root() { realpath "$startdir/../../../.."; }

pkgver() {
    local r
    r="$(_root)"
    printf '0.1.0.r%s.g%s' "$(git -C "$r" rev-list --count HEAD)" "$(git -C "$r" rev-parse --short HEAD)"
}

prepare() {
    # Tracked files of the working tree, so uncommitted edits are tested too.
    local r
    r="$(_root)"
    rm -rf "$srcdir/r9t-studio"
    (cd "$r" && git ls-files -z r9t-studio | tar --null -T - -cf -) | tar -xf - -C "$srcdir"
    cd "$srcdir/r9t-studio"
    export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
    (cd ui && npm ci --no-audit --no-fund)
    (cd ui/src-tauri && cargo fetch --locked)
}

build() {
    cd "$srcdir/r9t-studio"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --frozen
    cd ui
    CARGO_TARGET_DIR="$srcdir/target-ui" npx tauri build --no-bundle
}

check() {
    cd "$srcdir/r9t-studio"
    CARGO_TARGET_DIR="$srcdir/target" cargo test --release --frozen
    (cd ui/src-tauri && CARGO_TARGET_DIR="$srcdir/target-ui" cargo test --release --frozen)
}

package() {
    cd "$srcdir/r9t-studio"
    local lib=/usr/lib/r9t-studio
    install -Dm0755 -t "$pkgdir$lib" "$srcdir/target/release/"{r9td,r9tctl,r9t-session} \
        "$srcdir/target-ui/release/r9t-studio" tools/r9t-switch tools/r9t-switch-user
    install -d "$pkgdir/usr/bin"
    for b in r9tctl r9t-studio r9t-switch r9t-switch-user; do
        ln -s "$lib/$b" "$pkgdir/usr/bin/$b"
    done

    # Units and desktop file name the dev install path (/usr/local); rewrite it.
    _fix() { sed -e "s#/usr/local/lib/r9t-studio#$lib#g" -e 's#/usr/local/share/doc#/usr/share/doc#g' "$1"; }
    local u
    for u in r9td.service r9td-shadow.service r9t-fallback.service; do
        _fix "packaging/systemd/$u" | install -Dm0644 /dev/stdin "$pkgdir/usr/lib/systemd/system/$u"
    done
    install -Dm0644 packaging/systemd/slayer-r9t.service.d/r9t-conflicts.conf \
        "$pkgdir/usr/lib/systemd/system/slayer-r9t.service.d/r9t-conflicts.conf"
    _fix packaging/systemd-user/r9t-session.service | install -Dm0644 /dev/stdin "$pkgdir/usr/lib/systemd/user/r9t-session.service"
    _fix packaging/applications/r9t-studio.desktop | install -Dm0644 /dev/stdin "$pkgdir/usr/share/applications/r9t-studio.desktop"

    install -Dm0644 packaging/sysusers.d/r9t.conf "$pkgdir/usr/lib/sysusers.d/r9t.conf"
    install -Dm0644 packaging/polkit/org.r9t.studio.policy "$pkgdir/usr/share/polkit-1/actions/org.r9t.studio.policy"
    install -Dm0644 ui/src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/r9t-studio.png"
    install -Dm0644 packaging/waybar/r9t.jsonc "$pkgdir/usr/share/r9t-studio/waybar/r9t.jsonc"
    install -Dm0644 packaging/hyprland/r9t-session.conf "$pkgdir/usr/share/r9t-studio/hyprland/r9t-session.conf"
    install -Dm0644 docs/04_ana_plan.md "$pkgdir/usr/share/doc/r9t-studio/04_ana_plan.md"
    install -Dm0644 packaging/arch/README.md "$pkgdir/usr/share/doc/r9t-studio/PACKAGING.md"
}
